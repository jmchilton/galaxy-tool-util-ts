{
  "name": "@galaxy-tool-util/cache-ui",
  "version": "0.1.0",
  "description": "Vue 3 + PrimeVue panel for inspecting and managing the Galaxy tool cache exposed by gxwf-web / tool-cache-proxy",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*.vue": "./src/*.vue",
    "./cache-ui.css": "./src/cache-ui.css"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ test/",
    "format": "prettier --check 'src/**/*.{ts,vue}' 'test/**/*.ts'",
    "format-fix": "prettier --write 'src/**/*.{ts,vue}' 'test/**/*.ts'"
  },
  "dependencies": {
    "@galaxy-tool-util/tool-cache-proxy": "workspace:*",
    "openapi-fetch": "^0.13.8",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vue-tsc": "^2.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jmchilton/galaxy-tool-util-ts",
    "directory": "packages/cache-ui"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT"
}
