{
  "name": "@galaxy-tool-util/tool-cache-proxy-ui",
  "version": "0.2.1",
  "description": "Single-page Vue 3 frontend served by galaxy-tool-proxy — wraps @galaxy-tool-util/cache-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --check 'src/**/*.{ts,vue}'",
    "format-fix": "prettier --write 'src/**/*.{ts,vue}'"
  },
  "dependencies": {
    "@galaxy-tool-util/cache-ui": "workspace:*",
    "@primevue/themes": "^4.3.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^8.0.0",
    "vue-tsc": "^2.2.0"
  }
}
